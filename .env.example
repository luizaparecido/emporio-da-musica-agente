# Provedor do modelo: anthropic | gemini
LLM_PROVIDER=anthropic

# Preencha a chave do provedor escolhido
ANTHROPIC_API_KEY=

GEMINI_API_KEY=

# Opcional: troca o modelo padrão do provedor
# LLM_MODEL=claude-opus-5-5

# Opcional: nível de esforço no Claude (low | medium | high)
# ANTHROPIC_EFFORT=low

